# /* ---- 💫 https://github.com/JaKooLit 💫 ---- */  #
# /* wallust template - colors-btop */
# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#DCDBDB"

# Title color for boxes
theme[title]="#DCDBDB"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#5B6334"

# Background color of selected item in processes box
theme[selected_bg]="#6A1112"

# Foreground color of selected item in processes box
theme[selected_fg]="#131313"

# Color of inactive/disabled text
theme[inactive_fg]="#8A8988"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#757271"

# Background color of the percentage meters
theme[meter_bg]="#3B3B3B"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#6A1112"

# Cpu box outline color
theme[cpu_box]="#606936"

# Memory/disks box outline color
theme[mem_box]="#6A1112"

# Net up/down box outline color
theme[net_box]="#5B6334"

# Processes box outline color
theme[proc_box]="#757271"

# Box divider line and small boxes line color
theme[div_line]="#8A8988"

# Temperature graph colors
theme[temp_start]="#5B6334"
theme[temp_mid]="#373C22"
theme[temp_end]="#131411"

# CPU graph colors
theme[cpu_start]="#5B6334"
theme[cpu_mid]="#373C22"
theme[cpu_end]="#131411"

# Mem/Disk free meter
theme[free_start]="#757271"
theme[free_mid]="#757271"
theme[free_end]="#6A1112"

# Mem/Disk cached meter
theme[cached_start]="#5B6334"
theme[cached_mid]="#5B6334"
theme[cached_end]="#5B6334"

# Mem/Disk available meter
theme[available_start]="#606936"
theme[available_mid]="#606936"
theme[available_end]="#606936"

# Mem/Disk used meter
theme[used_start]="#131411"
theme[used_mid]="#131411"
theme[used_end]="#131411"

# Download graph colors
theme[download_start]="#5B6334"
theme[download_mid]="#5B6334"
theme[download_end]="#757271"

# Upload graph colors
theme[upload_start]="#606936"
theme[upload_mid]="#606936"
theme[upload_end]="#131411"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#5B6334"
theme[process_mid]="#373C22"
theme[process_end]="#131411"
