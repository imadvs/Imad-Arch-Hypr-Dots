# /* ---- 💫 https://github.com/JaKooLit 💫 ---- */  #
# /* wallust template - colors-btop */
# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#FCDBC4"

# Title color for boxes
theme[title]="#FCDBC4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#805152"

# Background color of selected item in processes box
theme[selected_bg]="#18355C"

# Foreground color of selected item in processes box
theme[selected_fg]="#070003"

# Color of inactive/disabled text
theme[inactive_fg]="#A98971"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#B87240"

# Background color of the percentage meters
theme[meter_bg]="#070003"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#18355C"

# Cpu box outline color
theme[cpu_box]="#805152"

# Memory/disks box outline color
theme[mem_box]="#18355C"

# Net up/down box outline color
theme[net_box]="#805152"

# Processes box outline color
theme[proc_box]="#B87240"

# Box divider line and small boxes line color
theme[div_line]="#A98971"

# Temperature graph colors
theme[temp_start]="#805152"
theme[temp_mid]="#545876"
theme[temp_end]="#3C2835"

# CPU graph colors
theme[cpu_start]="#805152"
theme[cpu_mid]="#545876"
theme[cpu_end]="#3C2835"

# Mem/Disk free meter
theme[free_start]="#B87240"
theme[free_mid]="#B87240"
theme[free_end]="#18355C"

# Mem/Disk cached meter
theme[cached_start]="#805152"
theme[cached_mid]="#805152"
theme[cached_end]="#805152"

# Mem/Disk available meter
theme[available_start]="#805152"
theme[available_mid]="#805152"
theme[available_end]="#805152"

# Mem/Disk used meter
theme[used_start]="#3C2835"
theme[used_mid]="#3C2835"
theme[used_end]="#3C2835"

# Download graph colors
theme[download_start]="#805152"
theme[download_mid]="#805152"
theme[download_end]="#B87240"

# Upload graph colors
theme[upload_start]="#805152"
theme[upload_mid]="#805152"
theme[upload_end]="#3C2835"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#805152"
theme[process_mid]="#545876"
theme[process_end]="#3C2835"
