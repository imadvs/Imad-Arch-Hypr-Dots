# /* ---- 💫 https://github.com/JaKooLit 💫 ---- */  #
# /* wallust template - colors-btop */
# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#FED9B0"

# Title color for boxes
theme[title]="#FED9B0"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#9B3E0D"

# Background color of selected item in processes box
theme[selected_bg]="#531F0D"

# Foreground color of selected item in processes box
theme[selected_fg]="#191516"

# Color of inactive/disabled text
theme[inactive_fg]="#AC865D"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#BD6D15"

# Background color of the percentage meters
theme[meter_bg]="#413C3C"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#531F0D"

# Cpu box outline color
theme[cpu_box]="#9B3E0D"

# Memory/disks box outline color
theme[mem_box]="#531F0D"

# Net up/down box outline color
theme[net_box]="#9B3E0D"

# Processes box outline color
theme[proc_box]="#BD6D15"

# Box divider line and small boxes line color
theme[div_line]="#AC865D"

# Temperature graph colors
theme[temp_start]="#9B3E0D"
theme[temp_mid]="#531F0D"
theme[temp_end]="#521F0D"

# CPU graph colors
theme[cpu_start]="#9B3E0D"
theme[cpu_mid]="#531F0D"
theme[cpu_end]="#521F0D"

# Mem/Disk free meter
theme[free_start]="#BD6D15"
theme[free_mid]="#BD6D15"
theme[free_end]="#531F0D"

# Mem/Disk cached meter
theme[cached_start]="#9B3E0D"
theme[cached_mid]="#9B3E0D"
theme[cached_end]="#9B3E0D"

# Mem/Disk available meter
theme[available_start]="#9B3E0D"
theme[available_mid]="#9B3E0D"
theme[available_end]="#9B3E0D"

# Mem/Disk used meter
theme[used_start]="#521F0D"
theme[used_mid]="#521F0D"
theme[used_end]="#521F0D"

# Download graph colors
theme[download_start]="#9B3E0D"
theme[download_mid]="#9B3E0D"
theme[download_end]="#BD6D15"

# Upload graph colors
theme[upload_start]="#9B3E0D"
theme[upload_mid]="#9B3E0D"
theme[upload_end]="#521F0D"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#9B3E0D"
theme[process_mid]="#531F0D"
theme[process_end]="#521F0D"
