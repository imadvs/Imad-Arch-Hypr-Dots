# /* ---- 💫 https://github.com/JaKooLit 💫 ---- */  #
# /* wallust template - colors-btop */
# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#D8D7CB"

# Title color for boxes
theme[title]="#D8D7CB"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#984A31"

# Background color of selected item in processes box
theme[selected_bg]="#4B2E22"

# Foreground color of selected item in processes box
theme[selected_fg]="#1E1F1D"

# Color of inactive/disabled text
theme[inactive_fg]="#868479"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#6C6950"

# Background color of the percentage meters
theme[meter_bg]="#444543"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#4B2E22"

# Cpu box outline color
theme[cpu_box]="#984A31"

# Memory/disks box outline color
theme[mem_box]="#4B2E22"

# Net up/down box outline color
theme[net_box]="#984A31"

# Processes box outline color
theme[proc_box]="#6C6950"

# Box divider line and small boxes line color
theme[div_line]="#868479"

# Temperature graph colors
theme[temp_start]="#984A31"
theme[temp_mid]="#87432D"
theme[temp_end]="#452B1E"

# CPU graph colors
theme[cpu_start]="#984A31"
theme[cpu_mid]="#87432D"
theme[cpu_end]="#452B1E"

# Mem/Disk free meter
theme[free_start]="#6C6950"
theme[free_mid]="#6C6950"
theme[free_end]="#4B2E22"

# Mem/Disk cached meter
theme[cached_start]="#984A31"
theme[cached_mid]="#984A31"
theme[cached_end]="#984A31"

# Mem/Disk available meter
theme[available_start]="#984A31"
theme[available_mid]="#984A31"
theme[available_end]="#984A31"

# Mem/Disk used meter
theme[used_start]="#452B1E"
theme[used_mid]="#452B1E"
theme[used_end]="#452B1E"

# Download graph colors
theme[download_start]="#984A31"
theme[download_mid]="#984A31"
theme[download_end]="#6C6950"

# Upload graph colors
theme[upload_start]="#984A31"
theme[upload_mid]="#984A31"
theme[upload_end]="#452B1E"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#984A31"
theme[process_mid]="#87432D"
theme[process_end]="#452B1E"
