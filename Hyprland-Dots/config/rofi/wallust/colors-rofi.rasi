alternate-normal-foreground: #DCDBDB;
alternate-urgent-background: #131313;
alternate-urgent-foreground: #DCDBDB;

selected-active-background: #808C48;
selected-active-foreground: #DCDBDB;
selected-normal-background: #808C48;
selected-normal-foreground: #DCDBDB;
selected-urgent-background: #798445;
selected-urgent-foreground: #DCDBDB;

background-color: #131313;
background: rgba(0,0,0,0.7);
foreground: #DCDBDB;
border-color: #798445;

color0: #3B3B3B;
color1: #131411;
color2: #6A1112;
color3: #373C22;
color4: #5B6334;
color5: #606936;
color6: #757271;
color7: #C5C3C3;
color8: #8A8988;
color9: #1A1B16;
color10: #8D1618;
