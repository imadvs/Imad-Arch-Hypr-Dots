 /* wallust template - colors-rofi */

* {
active-background: #B1450E;
active-foreground: #F5C8AE;
normal-background: #1B1614;
normal-foreground: #F5C8AE;
urgent-background: #E16219;
urgent-foreground: #F5C8AE;

alternate-active-background: #7D320A;
alternate-active-foreground: #F5C8AE;
alternate-normal-background: #1B1614;
alternate-normal-foreground: #F5C8AE;
alternate-urgent-background: #1B1614;
alternate-urgent-foreground: #F5C8AE;

selected-active-background: #E16219;
selected-active-foreground: #F5C8AE;
selected-normal-background: #E16219;
selected-normal-foreground: #F5C8AE;
