 /* wallust template - colors-rofi */

* {
active-background: #AB6C6E;
active-foreground: #FCDBC4;
normal-background: #070003;
normal-foreground: #FCDBC4;
urgent-background: #AB6C6E;
urgent-foreground: #FCDBC4;

alternate-active-background: #70759D;
alternate-active-foreground: #FCDBC4;
alternate-normal-background: #070003;
alternate-normal-foreground: #FCDBC4;
alternate-urgent-background: #070003;
alternate-urgent-foreground: #FCDBC4;

