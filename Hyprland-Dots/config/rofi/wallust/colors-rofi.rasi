 /* wallust template - colors-rofi */

* {
active-background: #CA6241;
active-foreground: #D8D7CB;
normal-background: #1E1F1D;
normal-foreground: #D8D7CB;
urgent-background: #CA6241;
urgent-foreground: #D8D7CB;

alternate-active-background: #B45A3C;
alternate-active-foreground: #D8D7CB;
alternate-normal-background: #1E1F1D;
alternate-normal-foreground: #D8D7CB;
alternate-urgent-background: #1E1F1D;
alternate-urgent-foreground: #D8D7CB;

selected-active-background: #CA6241;
selected-active-foreground: #D8D7CB;
selected-normal-background: #CA6241;
selected-normal-foreground: #D8D7CB;
selected-urgent-background: #CA6241;
selected-urgent-foreground: #D8D7CB;

background-color: #1E1F1D;
background: rgba(0,0,0,0.7);
foreground: #D8D7CB;
border-color: #CA6241;

color0: #444543;
color1: #452B1E;
color2: #4B2E22;
color3: #87432D;
color4: #984A31;
color5: #984A31;
color6: #6C6950;
