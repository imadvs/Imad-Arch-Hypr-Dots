 /* wallust template - colors-rofi */

* {
active-background: #798CB6;
active-foreground: #F7D7BE;
normal-background: #29282A;
normal-foreground: #F7D7BE;
urgent-background: #E88247;
urgent-foreground: #F7D7BE;

alternate-active-background: #858AA0;
alternate-active-foreground: #F7D7BE;
alternate-normal-background: #29282A;
alternate-normal-foreground: #F7D7BE;
alternate-urgent-background: #29282A;
alternate-urgent-foreground: #F7D7BE;

selected-active-background: #798CB6;
selected-active-foreground: #29282A;
selected-normal-background: #798CB6;
selected-normal-foreground: #29282A;
selected-urgent-background: #858AA0;
selected-urgent-foreground: #29282A;

background-color: #29282A;
background: rgba(0,0,0,0.7);
foreground: #F7D7BE;
border-color: #798CB6;

color0: #4E4E50;
color1: #456388;
color2: #A14E3B;
color3: #646778;
color4: #5B6988;
color5: #AE6135;
color6: #AE6A34;
color7: #EBBD9A;
color8: #A5856C;
color9: #5C84B5;
color10: #D7684F;
