 /* wallust template - colors-rofi */

* {
active-background: #CCE4E5;
active-foreground: #EEF7F9;
normal-background: #14151A;
normal-foreground: #EEF7F9;
urgent-background: #D1E8E9;
urgent-foreground: #EEF7F9;

alternate-active-background: #AEE1E9;
alternate-active-foreground: #EEF7F9;
alternate-normal-background: #14151A;
alternate-normal-foreground: #EEF7F9;
alternate-urgent-background: #14151A;
alternate-urgent-foreground: #EEF7F9;

selected-active-background: #CCE4E5;
selected-active-foreground: #14151A;
selected-normal-background: #CCE4E5;
selected-normal-foreground: #14151A;
selected-urgent-background: #AEE1E9;
selected-urgent-foreground: #14151A;

background-color: #14151A;
background: rgba(0,0,0,0.7);
foreground: #EEF7F9;
border-color: #CCE4E5;

color0: #3B3D41;
color1: #968F6D;
color2: #B99868;
color3: #82A9AF;
color4: #99ABAC;
color5: #9DAEAF;
