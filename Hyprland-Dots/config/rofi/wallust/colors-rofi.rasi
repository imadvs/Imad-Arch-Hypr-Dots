 /* wallust template - colors-rofi */

* {
active-background: #6A6A6D;
active-foreground: #DDDEDE;
normal-background: #1C1C1D;
normal-foreground: #DDDEDE;
urgent-background: #8E9092;
urgent-foreground: #DDDEDE;

alternate-active-background: #5D5E61;
alternate-active-foreground: #DDDEDE;
alternate-normal-background: #1C1C1D;
alternate-normal-foreground: #DDDEDE;
alternate-urgent-background: #1C1C1D;
alternate-urgent-foreground: #DDDEDE;

selected-active-background: #8E9092;
selected-active-foreground: #DDDEDE;
selected-normal-background: #8E9092;
selected-normal-foreground: #DDDEDE;
selected-urgent-background: #6A6A6D;
selected-urgent-foreground: #DDDEDE;

background-color: #1C1C1D;
background: rgba(0,0,0,0.7);
foreground: #DDDEDE;
border-color: #6A6A6D;

color0: #424344;
color1: #141518;
color2: #1A1B1E;
color3: #464749;
color4: #505052;
color5: #6B6C6D;
color6: #77787A;
color7: #C6C7C8;
color8: #8B8B8C;
color9: #1B1C20;
color10: #232428;
color11: #5D5E61;
color12: #6A6A6D;
color13: #8E9092;
color14: #9FA0A2;
color15: #C6C7C8;


}

