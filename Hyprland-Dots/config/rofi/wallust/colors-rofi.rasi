selected-active-foreground: #FCDBC4;
selected-normal-background: #AB6C6E;
selected-normal-foreground: #FCDBC4;
selected-urgent-background: #AB6C6E;
selected-urgent-foreground: #FCDBC4;

background-color: #070003;
background: rgba(0,0,0,0.7);
foreground: #FCDBC4;
border-color: #AB6C6E;

color0: #070003;
color1: #3C2835;
color2: #18355C;
color3: #545876;
color4: #805152;
color5: #805152;
color6: #B87240;
color7: #F2C3A2;
color8: #A98971;
