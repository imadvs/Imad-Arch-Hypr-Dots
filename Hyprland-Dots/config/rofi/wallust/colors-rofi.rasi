 /* wallust template - colors-rofi */

* {
active-background: #798445;
active-foreground: #DCDBDB;
normal-background: #131313;
normal-foreground: #DCDBDB;
urgent-background: #808C48;
urgent-foreground: #DCDBDB;

alternate-active-background: #49502D;
alternate-active-foreground: #DCDBDB;
