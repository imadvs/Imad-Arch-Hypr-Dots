 /* wallust template - colors-rofi */

* {
active-background: #9C9995;
active-foreground: #FFF6E6;
normal-background: #1F2121;
normal-foreground: #FFF6E6;
urgent-background: #F0CE8B;
urgent-foreground: #FFF6E6;

alternate-active-background: #828478;
alternate-active-foreground: #FFF6E6;
alternate-normal-background: #1F2121;
alternate-normal-foreground: #FFF6E6;
alternate-urgent-background: #1F2121;
alternate-urgent-foreground: #FFF6E6;

selected-active-background: #9C9995;
selected-active-foreground: #1F2121;
selected-normal-background: #9C9995;
selected-normal-foreground: #1F2121;
selected-urgent-background: #828478;
selected-urgent-foreground: #1F2121;

background-color: #1F2121;
background: rgba(0,0,0,0.7);
foreground: #FFF6E6;
border-color: #9C9995;

color0: #454748;
color1: #5D594A;
color2: #964629;
color3: #61635A;
color4: #757370;
color5: #B49A68;
color6: #BFAD89;
color7: #F6EAD3;
color8: #ADA493;
color9: #7D7763;
color10: #C85D37;
color11: #828478;
color12: #9C9995;
color13: #F0CE8B;
color14: #FFE6B7;
color15: #F6EAD3;


}

