[general]
 framerate = 60
 autosens = 1
 sensitivity = 100
 bars = 0
 bar_width = 2
 bar_spacing = 1
 bar_height_scaler = 1
 lower_cutoff_freq = 50
 higher_cutoff_freq = 10000
 sleep_timer = 0

[input]
 method = pulse
 source = auto

[output]
 method = noncurses
 orientation = bottom
 channels = stereo
 mono_option = average
 reverse = 0
 raw_target = /dev/stdout
 bit_format = 16bit
 ascii_max_range = 1000
 bar_delimiter = 32
 frame_delimiter = 10
 redraw_screen = 0

[color]
gradient = 1
gradient_count = 8
gradient_color_1 = '{{color2}}'
gradient_color_2 = '{{color10}}'
gradient_color_3 = '{{color4}}'
gradient_color_4 = '{{color12}}'
gradient_color_5 = '{{color5}}'
gradient_color_6 = '{{color13}}'
gradient_color_7 = '{{color14}}'
gradient_color_8 = '{{color15}}'

[smoothing]
 monstercat = 1
 waves = 0
 noise_reduction = 77
