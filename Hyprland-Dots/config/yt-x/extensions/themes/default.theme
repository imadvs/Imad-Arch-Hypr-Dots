# Semicolon RGB values for true color escape sequences
primary_rgb="142,156,152"
primary_rgb="${primary_rgb//,/;}"

secondary_rgb="165,157,146"
secondary_rgb="${secondary_rgb//,/;}"

accent_rgb="250,169,78"
accent_rgb="${accent_rgb//,/;}"

error_rgb="38,23,29"
error_rgb="${error_rgb//,/;}"

fg_rgb="247,240,228"
fg_rgb="${fg_rgb//,/;}"

green_rgb="149,56,28"
green_rgb="${green_rgb//,/;}"

# Set the yt-x interface colors
THEME_FZF_ICON_COLOR_PRIMARY="$(printf "\033[38;2;${primary_rgb}m")"
THEME_FZF_ICON_COLOR_SECONDARY="$(printf "\033[38;2;${secondary_rgb}m")"
THEME_FZF_ICON_COLOR_ACCENT="$(printf "\033[38;2;${accent_rgb}m")"
THEME_FZF_ICON_COLOR_ERROR="$(printf "\033[38;2;${error_rgb}m")"
THEME_FZF_PREVIEW_TITLE="$(printf "\033[38;2;${fg_rgb}m")"
THEME_FZF_PREVIEW_KEY="$(printf "\033[38;2;${primary_rgb}m")"
THEME_FZF_PREVIEW_VALUE="$(printf "\033[38;2;${fg_rgb}m")"
THEME_FZF_PREVIEW_DIVIDER="$(printf "\033[38;2;${secondary_rgb}m")"
THEME_PLAYER_START="$(printf "\033[38;2;${green_rgb}m")"

# Override FZF options by appending color overrides
CONFIG_FZF_OPTS="$CONFIG_FZF_OPTS \
  --color=bg+:#4E494B \
  --color=bg:#282425 \
  --color=border:#8E9C98 \
  --color=fg:#F7F0E4 \
  --color=gutter:#282425 \
  --color=header:#8E9C98 \
  --color=hl+:#8E9C98 \
  --color=hl:#8E9C98 \
  --color=info:#A59D92 \
  --color=marker:#FAA94E \
  --color=pointer:#FAA94E \
  --color=prompt:#8E9C98 \
  --color=query:#F7F0E4:regular \
  --color=scrollbar:#8E9C98 \
  --color=separator:#FAA94E \
  --color=spinner:#FAA94E"

# Override Gum options
CONFIG_GUM_FILTER_OPTS="--prompt.foreground #8E9C98 --indicator.foreground #8E9C98 --selected-indicator.foreground #8E9C98 --unselected-prefix.foreground #A59D92 --header.foreground #8E9C98 --text.foreground #F7F0E4 --cursor-text.foreground #F7F0E4 --match.foreground #8E9C98 --placeholder.foreground #A59D92 --prompt > --indicator ◆ --selected-prefix ◉ --unselected-prefix ○ --placeholder こんにちは..."
CONFIG_GUM_OPTS="$CONFIG_GUM_FILTER_OPTS"
CONFIG_GUM_INPUT_OPTS="--prompt.foreground #8E9C98 --cursor.foreground #F7F0E4 --placeholder こんにちは... --cursor.mode blink"
CONFIG_GUM_PAGER_OPTS="--foreground #F7F0E4 --line-number.foreground #A59D92 --match.foreground #8E9C98 --match-highlight.foreground #282425 --match-highlight.background #8E9C98 --help.foreground #A59D92 --show-line-numbers --soft-wrap --border-foreground #8E9C98"
CONFIG_GUM_SPIN_OPTS="--spinner dot --spinner.foreground #8E9C98 --title.foreground #A59D92 --align left"
CONFIG_GUM_CONFIRM_OPTS="--prompt.foreground #8E9C98 --selected.foreground #282425 --selected.background #8E9C98 --unselected.foreground #A59D92"
